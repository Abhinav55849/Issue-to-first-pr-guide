# =============================================================================
# Issue-to-First-PR Guide Environment Configuration
# =============================================================================

# [REQUIRED] Gemma AI API Key from Google AI Studio (https://aistudio.google.com/)
GEMMA_API_KEY=your_gemma_api_key_here

# [OPTIONAL] Gemma Model Identifier (defaults to gemma-2-9b-it)
# Examples: gemma-2-9b-it, gemma-2-27b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# [OPTIONAL] GitHub Personal Access Token (classic or fine-grained)
# Public issues can be analyzed without a token (60 requests/hr).
# Providing a token increases the GitHub REST API rate limit to 5,000 requests/hr.
GITHUB_TOKEN=
